@page
@model GroceryWebApp.Pages.Basket.UI.CartModel
@{
    ViewData["Title"] = "Cart";
}

@*<div class="container">
    <div class="row">
        <div class="col">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-page="Index">Home</a></li>
