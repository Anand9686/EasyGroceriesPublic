<div class="container mb-4">
    <div class="row">
        <div class="col-12">
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th scope="col"> </th>
                            <th scope="col">Product</th>
                            <th scope="col">Available</th>
                            <th scope="col">Unit</th>
                            <th scope="col">Price/Item</th>
                            <th scope="col" class="text-center">Quantity</th>
                            <th scope="col" class="text-right">Discount %</th>
                            <th scope="col" class="text-right">Price</th>
                            <th> </th>
                        </tr>
                    </thead>
                    <tbody>

                        @foreach (var cartItem in Model.Cart.Items)
                        {
                        <tr>
                            <td><img src="https://dummyimage.com/50x50/55595c/fff" /></td>
                            <td>@cartItem.Name</td>
                            <td>@cartItem.ItemStock</td>
                            <th>
                                <select id="@cartItem.Id-unitType" name="@cartItem.Id-unitType" asp-items="@cartItem.Units" onchange="UpdateUnit(this, @cartItem.Id, @cartItem.ProductId,@cartItem.CategoryId,@cartItem.VendorId,@cartItem.Quantity)">
                                </select>
                            </th>
                            <th>₹ @cartItem.Price</th>
                            <td><input  type="number" value="@cartItem.Quantity" onchange="UpdateQuantity(this, @cartItem.Id,@cartItem.ProductDetailId)" /></td>
                            <th>@cartItem.Discount</th>
                            <td class="text-right">₹ @cartItem.TotalPrice</td>
                            <td class="text-right">
                                <form asp-page-handler="removetocart" method="post">
                                    <button class="btn btn-sm btn-danger"><i class="fa fa-trash"></i></button>
                                    <input type="hidden" asp-for="@cartItem.ProductDetailId" name="productdetailId" />
                                    <input type="hidden" asp-for="@cartItem.UserID" name="userid" />
                                </form>

                            </td>
                        </tr>
                        }

                        <tr>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td><strong>Total</strong></td>
                            <td class="text-right"><strong>₹ @Model.Cart.TotalPrice</strong></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="col mb-2">
            <div class="row">
                <div class="col-sm-12  col-md-6">
                    @*<button class="btn btn-lg btn-block btn-danger">Continue Shopping</button>*@
                    <a asp-page="/Products/UI/Products" class="btn btn-lg btn-block btn-success">Continue Shopping</a>
                </div>
                <div class="col-sm-12 col-md-6 text-right">
                    <form asp-page="CheckOut" method="GET">
                        <input type="hidden" asp-for="@Model.Cart.BasketId" name="userid"/>
                        <button class="btn btn-lg btn-block btn-danger text-uppercase">CheckOut</button>
                    </form>
                        @*<a asp-page="CheckOut" class="btn btn-lg btn-block btn-danger text-uppercase">CheckOut</a>*@
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    var unitTypeSelected
    $(document).ready(function () {
    });
    function UpdateQuantity(elem, basketid,productdetailid) {
        var quantity = elem.value;
        $.ajax({
            type: 'POST',
            url: window.location.origin + "/BasketItem/UpdateBasket",
            data: "basketid=" + basketid + "&quantity=" + quantity + "&productdetailid=" + productdetailid,
            contentType: 'application/x-www-form-urlencoded; charset=UTF-8',
            dataType: 'json',
            success: function (data) {
                location.reload();
            },
            error: function (xhr, status, error) {
                alert("Error: " + error);
            }
        });
        return false;
    }

    function UpdateUnit(elem, basketId,productId,categoryId,vendorId,quantity) {
        var unitType = elem.value;
        $.ajax({
            type: 'POST',
            url: window.location.origin + "/BasketItem/UpdateBasketForType",
            data: "basketId=" + basketId + "&productId=" + productId + "&quantity=" + quantity + "&categoryId=" + categoryId + "&vendorId=" + vendorId +"&unitType=" + unitType,
            contentType: 'application/x-www-form-urlencoded; charset=UTF-8',
            dataType: 'json',
            success: function (data) {
                if (data == 0)
                    alert("Item Out of Stock");
                else
                    location.reload();
            },
            error: function (xhr, status, error) {
                alert("Error: " + error);
            }
        });
        return false;
    }
</script>
