@page
@model GroceryWebApp.Pages.Categories.Model.CategoryResponseModel
@{
}


<h1>Create Category</h1>
<hr />
<div class="row">
    <div class="col-md-4">
        <label id="CategoryCreaated" class="control-label"></label>
        <form method="post" id="CreateCategory">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="CategoryName" class="control-label">Category Name</label>
                <input asp-for="CategoryName" class="form-control" />
                <span asp-validation-for="CategoryName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CategoryDescr" class="control-label">Category Description</label>
                <input asp-for="CategoryDescr" class="form-control" />
                <span asp-validation-for="CategoryDescr" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CategoryParent" class="control-label">Category Type</label>
                <select id="CategoryParent" asp-for="CategoryParent" class="form-control">
                    <option value="">Select Category</option>
                </select>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="Flag" checked /> @Html.DisplayNameFor(model => model.Flag)
                </label>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" id="createcategory" class="btn btn-primary" />
            </div>
            <div class="form-group">
                <table id="grid-table"></table>
                <div id="grid-pager"></div>
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

<script type="text/javascript">
    $(document).ready(function () {
        var returndata = {};
      //  $('#CategoryCreaated').text('New Category to be  created Successfully');

        //Dropdown list load
        $.ajax({
            url: window.location.origin + "/CreateCategory/Index",
            type: "GET",
            contentType: "application/json; charset=utf-8",
            datatype: JSON,
            success: function (result) {
                $(result).each(function () {
                    $("#CategoryParent").append($("<option></option>").val(this.value).html(this.text));
                });
            },
            error: function (data) { }
        });

        //Create Category on button click
        $("#createcategory").click(function () {
            $("#CreateCategory").validate();
            if ($("#CreateCategory").valid()) {
                var data = $("#CreateCategory").serialize();
                if ($('#CategoryName').val() != '' && $('#CategoryDescr').val() != '') {
                    $.ajax({
                        type: "POST",
                        url: window.location.origin + "/CreateCategory/CreateNewCategory",
                        contentType: 'application/x-www-form-urlencoded; charset=UTF-8',
                        data: data,
                        dataType: 'json',
                        error: function (xhr, status, error) { },
                        success: function (response) {
                            // alert('New Category ' + response + ' created Successfully');
                            $('#CategoryCreaated').html('New Category ' + response + ' created Successfully');
                            $('#CategoryName').val("");
                            $('#CategoryDescr').val("");
                            $('#CategoryParent').val("");
                        }
                    });
                }
            }
            return false;
        });

        var grid_selector = "#grid-table";
        var pager_selector = "#grid-pager";

        


        $(window).resize(function () {
            $(grid_selector).jqGrid('setGridWidth', parseInt($(window).width()) - 400);
        });

        $(grid_selector).jqGrid({
            url: window.location.origin + "/CreateCategory/GetAllCategories",
            mtype: "GET",
            datatype: "json",
            //height: 400,
            colNames: ['Id', 'Category Name', 'Category Description', 'Category Parent','Flag'],
            colModel: [
                { name: "Id",width: 10, editable: true, hidden: true, editrules: { edithidden: false } },
                //{ name: "ProdDetailID", index: "ProdDetailID", width: 10, editable: true, hidden: true, editrules: { edithidden: false } },
                { name: "CategoryName", index: "CategoryName", width: 100, editable: true, editrules: { required: true } },
                { name: "CategoryDescr", index: "CategoryDescr", width: 100, editable: true, editrules: { required: true } },
                { name: "CategoryParent", index: "CategoryParent", width: 100, editable: true, editrules: { required: true } },              
                { name: "Flag", index: "Flag", width: 100, editable: true, editrules: { required: true }, edittype: 'checkbox',editoptions: {value: "true:false"}},
            ],
            loadonce: true,
            rowNum: 10,
            rowList: [10, 20, 30],
            pager: pager_selector,
            altRows: true,
            multiselect: true,
            multiboxonly: true,
            autowidth: true,
            shrinkToFit: true,
            sortname:'Id',
           // caption: "Product Details",
            loadComplete: function () {
                var table = this;
                setTimeout(function () {
                    updatePagerIcons(table);
                }, 0);
            }
        });

        $(grid_selector).jqGrid('navGrid', pager_selector,
            {
                edit: true, edittitle: "Edit Details", width: '67%',
                add: true, addtitle: "Add Details", width: '67%',
                del: false,
                search: true, addtitle: "Search Details", width: '100%',
                refresh: true,
                view: true, addtitle: "View Details", width: '100%',
            },
            //Edit Options. save key parameter will keybind the Enter key to submit.
            {
                editCaption: "Edit Category Details",
                edittext: "Edit",
                closeOnEscape: true,
                closeAfterEdit: true,
                savekey: [true, 25],
                errorTextFormat: commonError,
                width: "500",
                reloadAfterSubmit: true,
                bottominfo: "Fields marked with (*) are required",
                top: "60",
                left: "5",
                right: "5",
                beforeShowForm: function (frm) {
                    $('#grid-table').jqGrid("editCell", 0, 0, false);
                    //var myGrid = $('#grid-table'),
                    //    selectedRowId = myGrid.jqGrid('getGridParam', 'selrow'),
                    //    cellValue = myGrid.jqGrid('getCell', selectedRowId, 'UnitDetailId1');
                   // var rowData = myGrid.getRowData(selectedRowId);                    
                    
                    //if (cellValue !="")
                    //    $("#UnitDetailId").val(cellValue);
                },
                onclickSubmit: function (response, postdata) {
                    //call edit button
                    EditPost(postdata);
                },
                OnClose: function () { return Close(); },
            },
            //add Options. save key parameter will keybind the Enter key to submit.
            {
                addCaption: "Add Category Details",
                addtext: "Add",
                closeOnEscape: true,
                closeAfterEdit: true,
                savekey: [true, 13],
                errorTextFormat: commonError,
                width: "500",
                reloadAfterSubmit: true,
                bottominfo: "Fields marked with (*) are required",
                top: "60",
                left: "5",
                right: "5", 
                beforeShowForm: function (frm) {
                    //$("#UnitId").val("-1");
                    //$("#UnitDetailId").html(""); // clear before appending new list
                    //$("#UnitDetailId").append(
                    //    $('<option></option>').val("-1").html("Select Unit Size"));
                    //$("#UnitDetailId").val("-1");
                },
                onclickSubmit: function (response, postdata) {
                    AddPost(postdata);
                },
                beforeSubmit: function (postdata, formid) { return ValidateForm(postdata); },
                OnClose: function () { return Close(); },
            },
            //delete Options. save key parameter will keybind the Enter key to submit.
            {
                deleteCaption: "delete Category Details",
                deletetext: "Delete Post",
                closeOnEscape: true,
                closeAfterEdit: true,
                savekey: [true, 13],
                errorTextFormat: commonError,
                width: "500",
                reloadAfterSubmit: true,
                bottominfo: "Fields marked with (*) are required",
                top: "60",
                left: "5",
                right: "5",
                onclickSubmit: function (response, postdata) {
                    DeletePost(postdata);
                }
            }


        );

        function commonError(data) {
            return "Error Occured during Operation. Please try again";
        }
        function EditPost(params) {            
            SaveCategoryDetails(params);
        }
        function AddPost(params) {
            ////Here you need to define ajax call for insert records to server

            SaveCategoryDetails(params);
        }
        function DeletePost(params) {
            
        }
        function Close() {
            GetCategoryDetails();
            return true;
        }
        function ValidateForm(postdata) {
            //var selProduct = $("#Products").val();
            //var selCategory = $("#Category").val();
            //var selVendor = $("#Vendors").val();

            var error = "";
            if (postdata.CategoryName == "" || postdata.CategoryDescr == "" || postdata.CategoryParent == "") {
                error = error + "Please enter values to all the mandatory fields </br>";
            }
            
            

            return [(error != "" ? false : true), error];
        }

        function updatePagerIcons(table) {
            var replacement =
            {
                'ui-icon-seek-first': 'ace-icon fa fa-angle-double-left bigger-140',
                'ui-icon-seek-prev': 'ace-icon fa fa-angle-left bigger-140',
                'ui-icon-seek-next': 'ace-icon fa fa-angle-right bigger-140',
                'ui-icon-seek-end': 'ace-icon fa fa-angle-double-right bigger-140'
            };
            $('.ui-pg-table:not(.navtable) > tbody > tr > .ui-pg-button > .ui-icon').each(function () {
                var icon = $(this);
                var $class = $.trim(icon.attr('class').replace('ui-icon', ''));

                if ($class in replacement) icon.attr('class', 'ui-icon ' + replacement[$class]);
            })
        }

         

        function SaveCategoryDetails(params) {
            
            //var data = JSON.parse(JSON.stringify(params));
           
            //data["Id"] = (data["Id"] == "") ? 0 : data["Id"];           
            //delete data['grid-table_id'];           

            
            //params = { ctrRespModel: [{ data }] };
           
            //delete ctrRespModel[0].data['grid-table_id'];
            
            if (!ValidateForm(params)) { return false;}          
            $.ajax({
                url: window.location.origin + "/CreateCategory/CreateCategorys",
                method: "POST",
                dataType: 'json',
                contentType: "application/json",
                data: JSON.stringify(params),
                error: function (xhr, status, error) {
                   // alert('error - ' + error);
                },
                success: function (response) {
                    GetCategoryDetails();
                }
            });
        }

        function GetCategoryDetails() {
           
            
            $.ajax({
                url: window.location.origin + "/CreateCategory/GetAllCategories",
                type: "GET",
                contentType: "application/json; charset=utf-8",
                datatype: JSON,
                success: function (result) {
                    

                    var newdata = result;//You call Ajax peticion//

                        
                    $("#grid-table").jqGrid('clearGridData');
                    $("#grid-table").jqGrid('setGridParam', { data: newdata });
                    $("#grid-table")[0].refreshIndex();
                    $("#grid-table").trigger("reloadGrid");

                    
                },
                error: function (data) { }
            });
        }

        $(grid_selector).jqGrid('setGridWidth', parseInt($(window).width()) - 400);
    });

</script>

<style>
    .ui-widget,
    .ui-jqgrid > .ui-jqgrid-view,
    .ui-jqgrid-titlebar {
        font-size: 0.9em !important;
    }
    #grid-pager_center {
        float: left;
    }
    #searchmodfbox_grid-table {
        min-width: 650px;
    }

    $viewmodgrid-table {
        min-width: 500px;
    }
</style>

