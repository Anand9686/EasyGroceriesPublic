                { name: "Name", index: "Name", width: 100, editable: true, editrules: { required: true } },
                { name: "Description", index: "Description", width: 100, editable: true, editrules: { required: true } },
                { name: "Units", index: "Units", width: 100, editable: true, editrules: { required: true } },                
                { name: "Price", index: "Price", widt: 70, hidden:true, editable: true, },
                
                { name: "Discount", index: "Discount", width: 100, editable: true, editrules: { required: false, edithidden: true } },
                { name: "StockCount", index: "StockCount", width: 70, editable: true, editrules: { required: true } },
                { name: "ReorderLevel", index: "ReorderLevel", width: 100, editable: true,editrules: { required: true } },
                { name: "Flag", index: "Flag", width: 100, editable: true, editrules: { required: true }, edittype: 'checkbox',editoptions: {value: "true:false"}},
                {
                    name: "DiscountValidDate", index: "DiscountValidDate", width: 120, editable: true,
