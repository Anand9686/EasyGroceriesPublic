@page
@model GroceryWebApp.Pages.Products.Model.ProductResponseModel
@{
}


<h1>Create Product</h1>
<hr />
<div class="row">
    <div class="col-md-4">
        <label id="ProductCreaated" class="control-label"></label>
        <form method="post" id="CreateProduct">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Name" class="control-label">Product Name</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description" class="control-label">Product Description</label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Units" class="control-label">Units</label>
                <input asp-for="Units" class="form-control" />
                <span asp-validation-for="Units" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Price" class="control-label">Price</label>
                <input asp-for="Price" class="form-control" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="StockCount" class="control-label">Stock Count</label>
                <input asp-for="StockCount" class="form-control" />
                <span asp-validation-for="StockCount" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ReorderLevel" class="control-label">Re-order Level</label>
                <input asp-for="ReorderLevel" class="form-control" />
                <span asp-validation-for="ReorderLevel" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Discount" class="control-label">Discount</label>
                <input asp-for="Discount" class="form-control" />
                <span asp-validation-for="Discount" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DiscountValidDate" class="control-label">Discount Valid Till Date</label>
                <input asp-for="DiscountValidDate" class="form-control" />
                <span asp-validation-for="DiscountValidDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ImageName" class="control-label">Product Image Name</label>
                <input asp-for="ImageName" class="form-control" />
                <span asp-validation-for="ImageName" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="Flag" checked /> @Html.DisplayNameFor(model => model.Flag)
                </label>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" id="btnCreateProduct" class="btn btn-primary" />
            </div>

            <div class="form-group">
                <table id="grid-table"></table>
                <div id="grid-pager"></div>
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

<script type="text/javascript">
    $(document).ready(function () {
        var returndata = {};
      //  $('#CategoryCreaated').text('New Category to be  created Successfully');

        //Dropdown list load categores for the product
        $.ajax({
            url: window.location.origin + "/CreateCategory/Index",
            type: "GET",
            contentType: "application/json; charset=utf-8",
            datatype: JSON,
            success: function (result) {
                $(result).each(function () {
                    $("#Category").append($("<option></option>").val(this.value).html(this.text));
                });
            },
            error: function (data) { }
        });

         //Create Category on button click
        $("#btnCreateProduct").click(function () {
            $("#CreateProduct").validate();
            if ($("#CreateProduct").valid()) {
                var data = $("#CreateProduct").serialize();
                if ($('#Name').val() != '' && $('#Description').val() != '' && ($('#Price').val() != '' || $('#Price').val() <= 0)) {
                    $.ajax({
                        type: "POST",
                        url: window.location.origin + "/Product/CreateNewProduct",
                        contentType: 'application/x-www-form-urlencoded; charset=UTF-8',
                        data: data,
                        dataType: 'json',
                        error: function (xhr, status, error) { },
                        success: function (response) {
                            // alert('New Category ' + response + ' created Successfully');
                            $("#ProductCreaated").html('New Product ' + response + ' created Successfully');
                            $('#Name').val("");
                            $('#Description').val("");
                            $('#Units').val("");
                            $('#Price').val("");
                            $('#Discount').val("");
                            $('#StockCount').val("");
                            $('#ReorderLevel').val("");
                            $('#DiscountValidDate').val("");
                            $('#ImageName').val("");
                        }
                    });
                }
            }
            return false;
        });
        
        //GetUnits();
        //function GetUnits() {
            $.ajax({
                url: window.location.origin + "/Unit/GetUnits",
                async: false,
                type: "GET",
