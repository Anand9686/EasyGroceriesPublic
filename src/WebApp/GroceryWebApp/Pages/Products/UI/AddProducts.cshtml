                    //call edit button
                    EditPost(postdata);
                },
                OnClose: function () { return Close(); },
            },
            //add Options. save key parameter will keybind the Enter key to submit.
            {
                addCaption: "Add Product Details",
                addtext: "Add",
                closeOnEscape: true,
                closeAfterEdit: true,
                savekey: [true, 13],
