

@foreach (var product in Model)
{
    var prod = (GroceryWebApp.Pages.Products.Model.ProductDetail)product;
    <div class="col-sm col-sm-3">
        <div class="card">
            <a asp-page="" asp-route-productId="@prod.Id"><img asp-append-version="true" class="card-img-top" src="~/images/Groceries/@prod.ImageName" alt=""style="height: 143px;"></a>
            <div class="card-body">
                @*<h4 class="card-title"><a asp-page="/ProductDetail" asp-route-productId="@prod.Id" class="color-main">@prod.ProductSubDescription</a></h4>*@
                <p class="card-text">@prod.ProductSubDescription</p>
                <div class="row">
                    <div class="col">
                        <p class="btn btn-danger btn-block" style="height: 32px; display: block !important; border-radius: 15px !important; font-family: &quot;Insider-Open Sans&quot;, sans-serif !important; font-size: 14px !important; background-color: rgb(22, 68, 164) !important; border-color: rgb(22, 68, 164) !important;">₹ @prod.CartCost</p>
                    </div>
                  @*  <form asp-page-handler="AddToCart" method="post" name="addToCartForm" id="add_cart_form">*@
                <a href="javascript:;"  onclick='AddToCart("@prod.Id");return false;' class="btn btn-success btn-block" style="height: 32px; display: block !important; border-radius: 15px !important; font-family: &quot;Insider-Open Sans&quot;, sans-serif !important; font-size: 14px !important; background-color: #a2d605 !important; border-color: #a2d605 !important;">
                    Add to Cart
                </a>
                       
                    @*</form>*@
                </div>
            </div>
        </div>
    </div>
        }

