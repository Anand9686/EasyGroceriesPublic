@page
@model GroceryWebApp.Pages.Products.UI.ProductDetailModel
@{
}

<div class="row">
    <div class="col-md-4">
        <label id="PorductDetails" class="control-label"></label>
        <form method="post" id="formProductDetails" asp-page-handler="">
            @*<form method="post" id="GetProducts" asp-page-handler="">*@
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label class="control-label">Product</label>
                <select id="Products" class="form-control" asp-items="@Model.Products">
                    <option value="-1">Select Category</option>
                </select>
            </div>
            <div class="form-group">
                <label class="control-label">Category</label>
                <select id="Category" class="form-control" asp-items="@Model.Categories">
                    <option value="-1">Select Category</option>
                </select>
            </div>
            <div class="form-group">
                <label class="control-label">Vendor</label>
                <select id="Vendors" class="form-control" asp-items="@Model.Vendors">
                    <option value="-1">Select Category</option>
                </select>
            </div>
            <div class="form-group">
                <table id="grid-table"></table>
                <div id="grid-pager"></div>
            </div>

        </form>
    </div>
</div>



<script>


    $(document).ready(function () {
        debugger;
        var returndata = {};
        //GetUnits();
        //function GetUnits() {
            $.ajax({
                url: window.location.origin + "/Unit/GetUnits",
                async: false,
                type: "GET",
                contentType: "application/json; charset=utf-8",
                datatype: JSON,
                success: function (result) {
                    var data = '{ "-1": "Select Unit"';
                    var char = ",";
                    if (result.length > 0) {
                        var i = 1;
                        for (var key in result) {
                            data = data + char + '"' + result[key].Id + '": "' + result[key].UnitName + ((i < result.length) ? '", ' : '" }');
                            i = i + 1;
                            char = "";
                        }
                     //   console.log($.parseJSON(data));
                        returndata = $.parseJSON(data);
                    }
                },
                error: function (data) { }
            });
       // }
        //$("#Products").val(1);
        //$("#Category").val(1);
        //$("#Vendors").val(1);



        function getAllUnits() {            
            return returndata;
        }

        var grid_selector = "#grid-table";
        var pager_selector = "#grid-pager";

        $("#Products").change(dropDonwControlsChange);
        $("#Category").change(dropDonwControlsChange);
        $("#Vendors").change(dropDonwControlsChange);


        $(window).resize(function () {
            $(grid_selector).jqGrid('setGridWidth', parseInt($(window).width()) - 400);
        });

        function dropDonwControlsChange() {

            var selProduct = $("#Products").val();
            var selCategory = $("#Category").val();
            var selVendor = $("#Vendors").val();

            if (selProduct == -1 || selCategory == -1 || selVendor == -1) {
                // alert("Select Product, Category and Venodr info from the dropdown");
                return false;
            }
            GetProductDetails();
        }

        $(grid_selector).jqGrid({
            url: window.location.origin + "/Product/GetProductsDetail?productId=" + $("#Products").val() + "&categoryId=" + $("#Category").val() + "&vendorId=" + $("#Vendors").val(),
            mtype: "GET",
            datatype: "json",
            //height: 400,
            colNames: ['Id', 'Product Vendor Code', 'Product Vendor Name', 'Product Sub Description', 'Unit',"UnitDetailId1", "Unit Size Id", "Unit Size Desc",  'Cart Cost', 'Cost To Company', 'Quantity', 'Available Quantity', 'Discount', 'Discount Effective Start Date', 'Discount Effective End Date', 'Stock Arival Date', 'ImageName'],
            colModel: [
                { name: "Id",width: 10, editable: true, hidden: true, editrules: { edithidden: false } },
                //{ name: "ProdDetailID", index: "ProdDetailID", width: 10, editable: true, hidden: true, editrules: { edithidden: false } },
                { name: "ProductVendorCode", index: "ProductVendorCode", width: 100, editable: true, editrules: { required: true } },
                { name: "ProductVendorName", index: "ProductVendorName", width: 100, editable: true, editrules: { required: true } },
                { name: "ProductSubDescription", index: "ProductSubDescription", width: 100, editable: true, editrules: { required: true } },
                {
                    name: "UnitId", index: "UnitId", width: 70, editable: true, edittype: 'select', formatter: 'select', sortable: true, editoptions: {
                        value: getAllUnits(), editrules: { required: true }, 
                        dataEvents: [
                            {
                                type: 'change',
                                fn: function (e) {
                                    LoadUnitDetails($(e.target).val(),"-1");
                                }
                            }]}
                },
                { name: "UnitDetailId1", index: "UnitDetailId1", widt: 70, hidden:true, editable: true, },
                {
                    name: "UnitDetailId", index: "UnitDetailId", width: 0, editable: true, edittype: 'select', hidden: false, formatter: 'select', editoptions: {
                        value: "-1: Select Unit Size", editrules: { required: true, edithidden: false }
                    }
                },
                { name: "UnitDetailDesc", index: "UnitDetailDesc", width: 100, editable: false, editrules: { required: false, edithidden: true } },
                { name: "CartCost", index: "CartCost", width: 70, editable: true, formatter: 'currency', formatoptions: { decimalSeparator: ".", thousandsSeparator: ",", decimalPlaces: 2 }, editrules: { required: true } },
                { name: "CostToCompany", index: "CostToCompany", width: 100, editable: true, formatter: 'currency', formatoptions: { decimalSeparator: ".", thousandsSeparator: ",", decimalPlaces: 2 }, editrules: { required: true } },
                { name: "Quantity", index: "Quantity", width: 100, editable: true, editrules: { required: true } },
                { name: "AvailableQuantity", index: "AvailableQuantity", width: 100, editable: true, editrules: { required: true } },
                { name: "Discount", index: "Discount", widt: 70, editable: true, },
                {
                    name: "DiscountEffectiveStartDate", index: "DiscountEffectiveStartDate", width: 120, editable: true,
                    formatter: "date",
                    formatoptions: { srcformat: "ISO8601Long", newformat: "m/d/Y h:i A" },
                    editoptions: {
                        size: 20,
                        maxlengh: 20,
                        dataInit: function (element) {
                            $(element).datetimepicker({
                                changeYear: true,
                                changeMonth: true,
                                dateFormat: 'yy-mm-dd',
                                timeFormat: "'T'HH:mm:ss.SSS'Z's"
                            })
                        }
                    }
                },
                {
                    name: "DiscountEffectiveEndDate", index: "DiscountEffectiveEndDate", width: 120, editable: true,
                    formatter: "date",
                    formatoptions: { srcformat: "ISO8601Long", newformat: "m/d/Y h:i A" },
                    editoptions: {
                        size: 20,
                        maxlengh: 20,
                        dataInit: function (element) {
                            $(element).datetimepicker({
                                changeYear: true,
                                changeMonth: true,
                                dateFormat: 'yy-mm-dd',
                                timeFormat: "'T'HH:mm:ss.SSS'Z's"
                            })
                        }
                    }
                },
                {
                    name: "StockArivalDate", index: "StockArivalDate", width: 120, editable: true, editrules: { required: true },
                    formatter: "date",
                    formatoptions: { srcformat: "ISO8601Long", newformat: "m/d/Y h:i A" },
                    editoptions: {
                        size: 20,
                        maxlengh: 20,
                        dataInit: function (element) {
                            $(element).datetimepicker({
                                changeYear: true,
                                changeMonth: true,
                                dateFormat: "yy-mm-dd'T'HH:mm:ss.SSS'Z's"
                                // timeFormat: ""
                            });
                        }
                    }

                },
                { name: "ImageName", index: "ImageName", width: 100, editable: true, editrules: { required: true } },
            ],
            loadonce: true,
            rowNum: 10,
            rowList: [10, 20, 30],
            pager: pager_selector,
            altRows: true,
            multiselect: true,
            multiboxonly: true,
            autowidth: true,
            shrinkToFit: true,
            sortname:'Id',
           // caption: "Product Details",
            loadComplete: function () {
                var table = this;
                setTimeout(function () {
                    updatePagerIcons(table);
                }, 0);
            }
        });

        $(grid_selector).jqGrid('navGrid', pager_selector,
            {
                edit: true, edittitle: "Edit Details", width: '67%',
                add: true, addtitle: "Add Details", width: '67%',
                del: false,
                search: true, addtitle: "Search Details", width: '100%',
                refresh: true,
                view: true, addtitle: "View Details", width: '100%',
            },
            //Edit Options. save key parameter will keybind the Enter key to submit.
            {
                editCaption: "Edit Product Details",
                edittext: "Edit",
                closeOnEscape: true,
                closeAfterEdit: true,
                savekey: [true, 25],
                errorTextFormat: commonError,
                width: "500",
                reloadAfterSubmit: true,
                bottominfo: "Fields marked with (*) are required",
                top: "60",
                left: "5",
                right: "5",
                beforeShowForm: function (frm) {
                    $('#grid-table').jqGrid("editCell", 0, 0, false);
                    var myGrid = $('#grid-table'),
                        selectedRowId = myGrid.jqGrid('getGridParam', 'selrow'),
                        cellValue = myGrid.jqGrid('getCell', selectedRowId, 'UnitDetailId1');
                   // var rowData = myGrid.getRowData(selectedRowId);
                    if ($("#UnitId").val() != "-1") LoadUnitDetails($("#UnitId").val(), cellValue);
                    
                    //if (cellValue !="")
                    //    $("#UnitDetailId").val(cellValue);
                },
                onclickSubmit: function (response, postdata) {
                    //call edit button
                    EditPost(postdata);
                },
                OnClose: function () { return Close(); },
            },
            //add Options. save key parameter will keybind the Enter key to submit.
            {
                addCaption: "Add Product Details",
                addtext: "Add",
                closeOnEscape: true,
                closeAfterEdit: true,
                savekey: [true, 13],
                errorTextFormat: commonError,
                width: "500",
                reloadAfterSubmit: true,
                bottominfo: "Fields marked with (*) are required",
                top: "60",
                left: "5",
                right: "5",
                beforeShowForm: function (frm) {
                    $("#UnitId").val("-1");
                    $("#UnitDetailId").html(""); // clear before appending new list
                    $("#UnitDetailId").append(
                        $('<option></option>').val("-1").html("Select Unit Size"));
                    $("#UnitDetailId").val("-1");
                },
                onclickSubmit: function (response, postdata) {
                    AddPost(postdata);
                },
                beforeSubmit: function (postdata, formid) { return ValidateForm(postdata); },
                OnClose: function () { return Close(); },
            },
            //delete Options. save key parameter will keybind the Enter key to submit.
            {
                deleteCaption: "delete Product Details",
                deletetext: "Delete Post",
                closeOnEscape: true,
                closeAfterEdit: true,
                savekey: [true, 13],
                errorTextFormat: commonError,
                width: "500",
                reloadAfterSubmit: true,
                bottominfo: "Fields marked with (*) are required",
                top: "60",
                left: "5",
                right: "5",
                onclickSubmit: function (response, postdata) {
                    DeletePost(postdata);
                }
            }


        );

        function commonError(data) {
            return "Error Occured during Operation. Please try again";
        }
        function EditPost(params) {
            //Here you need to define ajax call for update records to server
            // params = { productId: selProduct, categoryId: selCategory, vendorId: selVendor, ...params }
            //  console.log(params);
            SaveProductDetails(params);
        }
        function AddPost(params) {
            ////Here you need to define ajax call for insert records to server

            SaveProductDetails(params);
        }
        function DeletePost(params) {
            //Here you need to define ajax call for delete records to server
            params = { productId: selProduct, categoryId: selCategory, vendorId: selVendor, ...params }
           // console.log(params);
        }
        function Close() {
            GetProductDetails();
            return true;
        }
        function ValidateForm(postdata) {
            var selProduct = $("#Products").val();
            var selCategory = $("#Category").val();
            var selVendor = $("#Vendors").val();

            var error = "";
            if (postdata.ProductVendorCode == "" || postdata.ProductVendorName == "" || postdata.UnitId <= 0
                || postdata.CartCost == "" || postdata.CostToCompany == "" || postdata.Quantity == "" || postdata.AvailableQuantity == ""
                || postdata.StockArivalDate == "" || postdata.ImageName == "" || selProduct <= 0 || selCategory <= 0 || selVendor <= 0) {
                error = error + "Please enter values to all the mandatory fields </br>";
            }
            if (!$.isNumeric(postdata.UnitId) || postdata.UnitId <=0) {
                error = error + "Please select a Unit </br>";
            }
            if (!$.isNumeric(postdata.CartCost) || postdata.CartCost <= 0) {
                error = error + "Please enter valid amount for Cart Cost </br>";
            }
            if (!$.isNumeric(postdata.CostToCompany) || postdata.CostToCompany <= 0) {
                error = error + "Please enter valid amount for Cost to Company </br>";
            }
            if (!$.isNumeric(postdata.Quantity) || postdata.Quantity <= 0) {
                error = error + "Please enter valid Quantity </br>";
            }
            if (!$.isNumeric(postdata.AvailableQuantity) || postdata.AvailableQuantity <= 0) {
                error = error + "Please enter valid Available Quantity </br>";
            }
            if (!$.isNumeric(selProduct) || selProduct <= 0) {
                error = error + "Please select a Product </br>";
            }
            if (!$.isNumeric(selCategory) || selCategory <= 0) {
                error = error + "Please select a Category </br>";
            }
            if (!$.isNumeric(selVendor) || selVendor <= 0) {
                error = error + "Please select a Vendor </br>";
            }
            if (Date.parse(StockArivalDate) <=0) {
                error = error + "Please select a Stock Arival Date </br>";
            }
            if (Date.parse(DiscountEffectiveStartDate) > Date.parse(DiscountEffectiveEndDate)) {
                error = error + "Please select Discount Effective End Date greater than Discount Start End Date </br>";
            }

            return [(error != "" ? false : true), error];
        }

        function updatePagerIcons(table) {
            var replacement =
            {
                'ui-icon-seek-first': 'ace-icon fa fa-angle-double-left bigger-140',
                'ui-icon-seek-prev': 'ace-icon fa fa-angle-left bigger-140',
                'ui-icon-seek-next': 'ace-icon fa fa-angle-right bigger-140',
                'ui-icon-seek-end': 'ace-icon fa fa-angle-double-right bigger-140'
            };
            $('.ui-pg-table:not(.navtable) > tbody > tr > .ui-pg-button > .ui-icon').each(function () {
                var icon = $(this);
                var $class = $.trim(icon.attr('class').replace('ui-icon', ''));

                if ($class in replacement) icon.attr('class', 'ui-icon ' + replacement[$class]);
            })
        }

        function LoadUnitDetails(unitId, selectedIndex) {
           // alert(selectedIndex);
            $.ajax({
                url: window.location.origin + "/Unit/GetUnitDetail?unitId=" + unitId,
                type: "GET",
                contentType: "application/json; charset=utf-8",
                datatype: JSON,
                success: function (result) {
                    if (result.length > 0) {
                       // alert(result.length);
                        $("#UnitDetailId").html(""); // clear before appending new list
                        $("#UnitDetailId").append(
                            $('<option></option>').val("-1").html("Select Unit Size"));
                        $.each(result, function (i, item) {
                            $("#UnitDetailId").append(
                                $('<option></option>').val(item.Id).html(item.UnitDescription));
                        });
                        $("#UnitDetailId").val(selectedIndex);
                    }
                    //else {

                    //}
                },
                error: function (data) { }
            });
        }

        function SaveProductDetails(params) {
            var selProduct = $("#Products").val();
            var selCategory = $("#Category").val();
            var selVendor = $("#Vendors").val();
            if (selProduct == -1 || selCategory == -1 || selVendor == -1) {
                return false;
            }
            var data = JSON.parse(JSON.stringify(params));
           
            data["Id"] = (data["Id"] == "") ? 0 : data["Id"];
            data["Discount"] = (data["Discount"] == "") ? 0 : data["Discount"];
            
            $.each(data, function (key, value) {
                //  converting date to UTC format;
                if (key == "DiscountEffectiveStartDate" || key == "DiscountEffectiveEndDate" || key == "StockArivalDate") {
                    data[key] = new Date(value).toISOString();
                }
            });

            params = { ProductDetail: [{ ProductId: selProduct, CategoryId: selCategory, VendorId: selVendor, ...data }] };
            if (!ValidateForm(params)) { return false;}
          //  console.log(JSON.stringify(params));
            $.ajax({
                url: window.location.origin + "/Product/CreateProductDetails",
                method: "POST",
                dataType: 'json',
                contentType: 'application/json',
                data: JSON.stringify(params),
                error: function (xhr, status, error) {
                   // alert('error - ' + error);
                },
                success: function (response) {
                    GetProductDetails();
                }
            });
        }

        function GetProductDetails() {
           // $("#grid-table").jqGrid('setGridParam', { datatype: 'json' }).trigger('reloadGrid');
           // console.log("from function - " + returndata);

            var selProduct = $("#Products").val();
            var selCategory = $("#Category").val();
            var selVendor = $("#Vendors").val();
            // alert(response);
            $.ajax({
                url: window.location.origin + "/Product/GetProductsDetail?productId=" + selProduct + "&categoryId=" + selCategory + "&vendorId=" + selVendor,
                type: "GET",
                contentType: "application/json; charset=utf-8",
                datatype: JSON,
                success: function (result) {
                    //if (result.length > 0) {

                    var newdata = result;//You call Ajax peticion//

                        //$("#grid-table").jqGrid('clearGridData')
                        //    .jqGrid('setGridParam', { data: newdata, datatype: 'json' })
                        //.trigger('reloadGrid');
                    $("#grid-table").jqGrid('clearGridData');
                    $("#grid-table").jqGrid('setGridParam', { data: newdata });
                    $("#grid-table")[0].refreshIndex();
                    $("#grid-table").trigger("reloadGrid");

                    //}
                    //else {

                    //}
                },
                error: function (data) { }
            });
        }

        $(grid_selector).jqGrid('setGridWidth', parseInt($(window).width()) - 400);

    });
</script>

