<div class="container mt-3">
    <div class="row">
        <div class="col-sm">
            <div class="card">
                <div class="card-header bg-secondary text-white text-uppercase">
                    <i class="fa fa-star"></i> Grocery products
                </div>
                
                <div class="card-body bg-dark">
                    <marquee>
                    <div class="row">
                        
                        @foreach (var product in Model.Products.Take(4))
                        {
                            <div class="col-sm">
                                <partial name="~/Pages/Products/UI/Partial/_ProductItemPartial.cshtml" model="@product" />
                            </div>
                        }

                    </div>
                    </marquee>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="container mt-3">
    <div class="row">
        <div class="col-sm">
            <div class="card">
                <div class="card-body">
                    <div id="scrollInfinite" class="row">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    var self = this;
    var page = 1;
    var incallback = false;
    var complete = 0;
    $(document).ready(function () { loadproducts();});
    function loadproducts() {
        if (page > -1 && !incallback && complete < page) {
            incallback = true;
            complete = page;
           // page++;
            $.ajax({
                type: 'POST',
                data: 'page=' + page + '&size=10',
             //   headers: { "Authorization": 'Bearer ' + localStorage.getItem('token') },
                //url: window.location.origin + '/Products/UI/Products?handler=ScrollGetContent',
                url: window.location.origin + '/Product/GetScrollContent',
                contentType: 'application/x-www-form-urlencoded; charset=UTF-8',
                success: function (data) {
                    if ($.trim(data) != '') {
                        page = page + 1;
                        $('#scrollInfinite').append(data);
                    }
                },
                error: function (error) {
                    alert("Error: " + error);
                }
            });
        }
    }

    document.getElementsByTagName('body')[0].onscroll = function () {
        console.log("scrolling");
    };

    function onScroll() {
        if ((window.innerHeight + window.scrollY) >= document.body.offsetHeight) {
            incallback = false;
            loadproducts();
        }
    }

    window.onscroll = function (ev) {
        onScroll();
    };


    function AddToCart(item) {
        $.ajax({
            type: 'POST',
            url: window.location.origin + "/BasketItem/CreateBasket",
            data: "productDetailId=" + item,
            contentType: 'application/x-www-form-urlencoded; charset=UTF-8',
            dataType: 'json',
            success: function (data) {
               // alert(data);
                $('#CartCount').text(data);
            },
            error: function (xhr, status, error) {
                alert("Error: " + error);
            }
        });
    }
</script>

